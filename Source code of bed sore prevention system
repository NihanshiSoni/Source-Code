    },
    monsoon: {
      label: "Monsoon", ambient: "26–34 °C, RH 70–90 %",
      base: { pressure: 27, temperature: 34.0, humidity: 62, friction: 0.44 },
      rise: { temperature: 1.9, humidity: 24 },
      thr: { temperature: { caution: 35.5, unsafe: 36.5 }, humidity: { caution: 75, unsafe: 87 } }
    },
    winter: {
      label: "Winter", ambient: "6–22 °C, RH 30–55 %",
      base: { pressure: 29, temperature: 32.8, humidity: 40, friction: 0.35 },
      rise: { temperature: 1.6, humidity: 12 },
      thr: { temperature: { caution: 34.3, unsafe: 35.3 }, humidity: { caution: 55, unsafe: 67 } }
    }

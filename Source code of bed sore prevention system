<script>
(function(){
  const firebaseConfig = {
    apiKey: "AIzaSyB5MoT4d_H90SPUgllgTzkfW6hV7deQFtM",
    authDomain: "bedsore-prevention-system.firebaseapp.com",
    projectId: "bedsore-prevention-system",
    storageBucket: "bedsore-prevention-system.firebasestorage.app",
    messagingSenderId: "678800740211",
    appId: "1:678800740211:web:d9a57dfad0e1149592bf06"
  };
  const statusEl = document.getElementById("fbStatus");
  const connectBtn = document.getElementById("fbConnectBtn");
  const saveBtn = document.getElementById("fbSaveBtn");
  const loadBtn = document.getElementById("fbLoadBtn");
  const historyEl = document.getElementById("fbHistory");
  let db = null, currentUser = null;

  function status(message, isError=false) {
    statusEl.textContent = message;
    statusEl.style.color = isError ? "#d6414e" : "var(--safe,#1fa97c)";
  }
  function showMessage(message) {
    historyEl.textContent = message;
  }
  function safeText(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }

  connectBtn.addEventListener("click", async () => {
    connectBtn.disabled = true;
    try {
      if (!window.firebase) throw new Error("Firebase SDK did not load. Check your internet connection.");
      if (!firebase.apps.length) firebase.initializeApp(firebaseConfig);
      db = firebase.firestore();
      const auth = firebase.auth();
      const result = auth.currentUser ? {user: auth.currentUser} : await auth.signInAnonymously();
      currentUser = result.user;
      status("Connected to Firebase (demo account).");
      saveBtn.disabled = false;
      loadBtn.disabled = false;
      showMessage("Connected. You can now save a clearly labelled demo reading.");
    } catch (err) {
      status(err.message || "Connection failed.", true);
      showMessage("If the message mentions permissions, Firebase setup rules still need to be completed. Do not make the database public.");
      connectBtn.disabled = false;
    }
  });

  saveBtn.addEventListener("click", async () => {
    try {
      if (!db || !currentUser) throw new Error("Connect to Firebase first.");
      const snapshot = window.getBedsoreDemoSnapshot && window.getBedsoreDemoSnapshot();
      if (!snapshot) throw new Error("Dashboard readings are not available.");
      const finiteOrNull = value => Number.isFinite(Number(value)) ? Number(value) : null;
      const record = {
        uid: currentUser.uid,
        source: "SIMULATED_DEMO_DATA",
        createdAt: firebase.firestore.FieldValue.serverTimestamp(),
        readings: {
          pressure: finiteOrNull(snapshot.values.pressure),
          temperature: finiteOrNull(snapshot.values.temperature),
          humidity: finiteOrNull(snapshot.values.humidity),
          moisture: finiteOrNull(snapshot.values.friction)
        },
        statuses: {...snapshot.status},
        note: "Demonstration data only; not a clinical record."
      };
      await db.collection("demoSensorReadings").add(record);
      status("Demo reading saved successfully.");
      showMessage("Saved one simulated demo reading. Use “Load my saved readings” to view it.");
    } catch (err) {
      status(err.message || "Could not save reading.", true);
      showMessage("If this is a permissions error, follow the Firestore security-rules setup before trying again. Do not use public read/write rules.");
    }
  });

  loadBtn.addEventListener("click", async () => {
    try {
      if (!db || !currentUser) throw new Error("Connect to Firebase first.");
      const snap = await db.collection("demoSensorReadings")
        .where("uid", "==", currentUser.uid)
        .orderBy("createdAt", "desc").limit(10).get();
      historyEl.innerHTML = "";
      if (snap.empty) { showMessage("No saved demo readings yet."); return; }
      snap.forEach(doc => {
        const d = doc.data(), r = d.readings || {};
        const line = document.createElement("div");
        line.innerHTML = `<strong>SIMULATED</strong> · ${safeText(d.createdAt && d.createdAt.toDate ? d.createdAt.toDate().toLocaleString() : "Just now")}<br>
          Pressure: ${safeText(r.pressure)} · Temperature: ${safeText(r.temperature)} · Humidity: ${safeText(r.humidity)} · Moisture: ${safeText(r.moisture)}`;
        historyEl.appendChild(line);
      });
      status("Loaded saved demo readings.");
    } catch (err) {
      status(err.message || "Could not load readings.", true);
      showMessage("If Firebase asks for an index, use the link shown in the browser error to create it. If permission is denied, check the secure rules.");
    }
  });
})();
</script>





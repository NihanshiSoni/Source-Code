    function interp(K, z) {
      if (z < K[0][0] || z > K[K.length - 1][0]) return null;
      for (let i = 0; i < K.length - 1; i++) {
        if (z <= K[i + 1][0]) {
          const t = (z - K[i][0]) / (K[i + 1][0] - K[i][0]);

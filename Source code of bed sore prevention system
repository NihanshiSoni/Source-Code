  }
  function statusOf(id, v) {
    const t = getThreshold(id);
    return v >= t.unsafe ? "unsafe" : v >= t.caution ? "caution" : "safe";
  }
  const statusHex = (s) => (s === "unsafe" ? 0xd6414e : s === "caution" ? 0xc98a12 : 0x1fa97c);

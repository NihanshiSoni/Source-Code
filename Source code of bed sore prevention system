      const Cc = dx * dx * (c * c / (a * a) + s * s / (b * b)) - 1;
      const disc = B * B - 4 * A * Cc;
      if (disc < 0) return 0;
      return Math.max(0, yc + (-B + Math.sqrt(disc)) / (2 * A));

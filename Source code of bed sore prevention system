  const FIXED = {
    pressure: { caution: 32, unsafe: 50 },
    friction: { caution: 0.50, unsafe: 0.70 },
    time: { caution: 90, unsafe: 120 }
  };
  const PARAMS = [
    { id: "pressure",    label: "Pressure",         site: "sacrum sensor",        unit: "mmHg", min: 0,   max: 100, decimals: 0, step: 1,    seasonal: false, model: true, tau: 0.7, noise: 0.8,   node: true, nodePos: 0.45 },
    { id: "temperature", label: "Skin temperature", site: "upper back sensor",    unit: "°C",   min: 30,  max: 39,  decimals: 1, step: 0.1,  seasonal: true,  model: true, tau: 2.4, noise: 0.04,  node: true, nodePos: -1.35 },
    { id: "humidity",    label: "Humidity",         site: "mid back sensor",      unit: "% RH", min: 0,   max: 100, decimals: 0, step: 1,    seasonal: true,  model: true, tau: 2.0, noise: 0.5,   node: true, nodePos: -0.4 },
    { id: "friction",    label: "Friction",         site: "heel / sheet sensor",  unit: "μ",    min: 0.2, max: 1.0, decimals: 2, step: 0.01, seasonal: false, model: true, tau: 0.9, noise: 0.008, node: true, nodePos: 2.55 },

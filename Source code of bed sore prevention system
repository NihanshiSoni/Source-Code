    const TORSO = [[-2.0, 0.32, 0.08], [-1.75, 0.62, 0.20], [-1.2, 0.60, 0.27], [-0.4, 0.50, 0.25], [0.5, 0.52, 0.24], [1.0, 0.45, 0.19], [1.3, 0.2, 0.1], [1.5, 0, 0]];

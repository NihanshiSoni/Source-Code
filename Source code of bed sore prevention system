    if (anyUnsafe()) return "unsafe";
    return PARAMS.some((p) => state.status[p.id] === "caution") ? "caution" : "safe";
  }

  // Simulated readings after t minutes in one position
  function modelTarget(id) {
    const S = SEASONS[state.season], t = state.tpos, b = S.base;
    const hRise = S.rise.humidity * (1 - Math.exp(-t / 60));
    switch (id) {
      case "pressure":    return b.pressure + 24 * Math.pow(Math.min(t, 180) / 120, 1.3) + state.mods.pressure;

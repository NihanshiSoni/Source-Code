      const stem = new THREE.Mesh(new THREE.CylinderGeometry(0.008, 0.008, stemH, 6), stemMat);
      stem.position.set(0, mattressTopY + 0.05 + stemH / 2, p.nodePos);
      scene.add(stem);
      nodes[p.id] = { group, core, halo, stem, cur: statusCol.safe.clone(), tgt: statusCol.safe.clone() };

      const el = document.createElement("div");
      el.className = "node-label";
      el.innerHTML = '<span class="dot"></span><span class="txt"></span>';
      sceneWrap.appendChild(el);
      labelEls[p.id] = { el, txt: el.querySelector(".txt") };
    });

    function applyRoll() {
      updateBody(state.roll);
      const shift = -Math.sin(state.roll) * 0.12;
      head.rotation.z = state.roll * 0.55;
      head.position.x = shift * 0.6;
      Object.keys(nodes).forEach((id) => { nodes[id].group.position.x = shift; nodes[id].stem.position.x = shift; });
    }
    applyRoll();

    // ---------- orbit camera ----------
    const target = new THREE.Vector3(0, mattressTopY + 0.3, 0);
    let radius = 11, theta = Math.PI * 0.27, phi = Math.PI * 0.35, userZoomed = false;
    function applyCamera() {
      camera.position.x = target.x + radius * Math.sin(phi) * Math.sin(theta);
      camera.position.y = target.y + radius * Math.cos(phi);
      camera.position.z = target.z + radius * Math.sin(phi) * Math.cos(theta);
      camera.lookAt(target);
    }
    function resize() {
      const w = sceneWrap.clientWidth || 1, h = sceneWrap.clientHeight || 1;
      camera.aspect = w / h; camera.updateProjectionMatrix(); renderer.setSize(w, h);
      if (!userZoomed) radius = camera.aspect < 1.3 ? 14 : 10.5;
      applyCamera();
    }
    if (window.ResizeObserver) new ResizeObserver(resize).observe(sceneWrap);
    window.addEventListener("resize", resize);
    resize();

    const dom = renderer.domElement, pointers = new Map();
    let pinchDist = 0, dragVX = 0, dragVY = 0, lastMoveAt = 0;
    const pinchDistance = () => { const v = Array.from(pointers.values()); return Math.hypot(v[0].x - v[1].x, v[0].y - v[1].y); };
    dom.addEventListener("pointerdown", (e) => {
      dom.setPointerCapture(e.pointerId); pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (pointers.size === 2) pinchDist = pinchDistance();
    });
    dom.addEventListener("pointermove", (e) => {
      if (!pointers.has(e.pointerId)) return;
      const prev = pointers.get(e.pointerId), cur = { x: e.clientX, y: e.clientY };
      if (pointers.size === 1) {
        const dx = cur.x - prev.x, dy = cur.y - prev.y;
        theta -= dx * 0.006;
        phi = clamp(phi - dy * 0.006, Math.PI * 0.12, Math.PI * 0.49);
        dragVX = -dx * 0.0009; dragVY = -dy * 0.0009; lastMoveAt = performance.now();
      }
      pointers.set(e.pointerId, cur);
      if (pointers.size === 2) {
        const d = pinchDistance();
        if (pinchDist > 0 && d > 0) radius = clamp(radius * (pinchDist / d), 4.5, 20);
        pinchDist = d; userZoomed = true;
      }
      applyCamera();
    });
    const endPointer = (e) => { pointers.delete(e.pointerId); pinchDist = 0; };
    dom.addEventListener("pointerup", endPointer);
    dom.addEventListener("pointercancel", endPointer);
    dom.addEventListener("wheel", (e) => {
      e.preventDefault(); userZoomed = true;
      radius = clamp(radius + e.deltaY * 0.01, 4.5, 20); applyCamera();
    }, { passive: false });

    // ---------- labels ----------
    const projVec = new THREE.Vector3();
    function updateLabels() {
      const w = sceneWrap.clientWidth, h = sceneWrap.clientHeight;
      PARAMS.filter((p) => p.node).forEach((p) => {
        const l = labelEls[p.id], s = state.status[p.id] || "safe";
        projVec.set(nodes[p.id].group.position.x, nodeY + 0.26, p.nodePos).project(camera);
        if (projVec.z > 1) { l.el.style.display = "none"; return; }
        l.el.style.display = "flex";
        l.el.style.left = ((projVec.x * 0.5 + 0.5) * w) + "px";
        l.el.style.top = ((-projVec.y * 0.5 + 0.5) * h) + "px";
        l.el.className = "node-label " + s;
        const val = state.values[p.id].toFixed(p.decimals) + (p.unit === "μ" ? "" : " " + p.unit);
        l.txt.textContent = s === "unsafe" ? p.label + " " + val + " — UNSAFE" : p.label + " " + val;
      });
    }

    // ---------- per-frame render ----------
    render3D = function (dt, nowMs) {
      const t = nowMs / 1000;
      if (pointers.size === 0 && nowMs - lastMoveAt < 1200 && (Math.abs(dragVX) + Math.abs(dragVY) > 0.00008)) {
        theta += dragVX; phi = clamp(phi + dragVY, Math.PI * 0.12, Math.PI * 0.49);
        dragVX *= 0.92; dragVY *= 0.92; applyCamera();
      }
      const dr = state.rollTarget - state.roll;
      if (Math.abs(dr) > 0.0004) {
        state.roll += dr * (1 - Math.exp(-dt * 2.6));
        if (Math.abs(state.rollTarget - state.roll) < 0.0004) state.roll = state.rollTarget;
        applyRoll();
      }
      PARAMS.filter((p) => p.node).forEach((p, i) => {
        const n = nodes[p.id], s = state.status[p.id] || "safe";
        n.tgt.copy(statusCol[s]);
        n.cur.lerp(n.tgt, 0.14);
        n.core.material.color.copy(n.cur); n.core.material.emissive.copy(n.cur); n.halo.material.color.copy(n.cur);
        const speed = s === "unsafe" ? 7 : s === "caution" ? 3 : 1.2;
        const amp = s === "unsafe" ? 0.35 : s === "caution" ? 0.18 : 0.08;
        n.halo.scale.setScalar((1 + amp * Math.sin(t * speed + i)) * (s === "unsafe" ? 1.4 : 1));
        n.group.position.y = nodeY + 0.03 * Math.sin(t * 1.5 + i);
        n.core.material.emissiveIntensity = s === "unsafe" ? 1.0 + 0.6 * Math.sin(t * 10) : 0.9;
      });
      const overall = overallStatus();
      ledTgt.copy(statusCol[overall]); ledCur.lerp(ledTgt, 0.14);
      ledMat.color.copy(ledCur); ledMat.emissive.copy(ledCur); ledHalo.material.color.copy(ledCur);
      ledMat.emissiveIntensity = overall === "unsafe" ? (Math.sin(t * 12) > 0 ? 1.6 : 0.2) : 0.9;
      ledHalo.scale.setScalar(overall === "unsafe" ? 1.3 + 0.3 * Math.sin(t * 12) : 1);
      updateLabels();
      renderer.render(scene, camera);
    };
  }

  // =====================================================================
  // BUZZER (Web Audio)
  // =====================================================================
  function unlockAudio() {
    if (audio.ctx) { if (audio.ctx.state === "suspended") audio.ctx.resume(); return; }
    try {
      const AC = window.AudioContext || window.webkitAudioContext;
      if (!AC) return;
      audio.ctx = new AC();
      const osc = audio.ctx.createOscillator();
      audio.gain = audio.ctx.createGain();
      osc.type = "square"; osc.frequency.value = 1000; audio.gain.gain.value = 0;
      osc.connect(audio.gain); audio.gain.connect(audio.ctx.destination); osc.start();
    } catch (err) { audio.ctx = null; audio.gain = null; }
  }
  document.addEventListener("pointerdown", unlockAudio);
  document.addEventListener("keydown", unlockAudio);
  function updateBuzzer(nowMs) {
    if (!audio.ctx || !audio.gain) return;

    // Sound on any unsafe monitored condition. The caretaker's reposition button
    // silences this episode; the alarm re-arms once the readings return to safe.
    const shouldBeep = anyUnsafe() && !alarmAcknowledged && !muted;

    if (!shouldBeep) {
      audio.on = false;
      try {
        audio.gain.gain.cancelScheduledValues(audio.ctx.currentTime);
        audio.gain.gain.setValueAtTime(0, audio.ctx.currentTime);
      } catch (err) {}
      return;
    }

    if (nowMs - audio.last >= 450) {
      audio.on = !audio.on;
      audio.last = nowMs;
      try {
        audio.gain.gain.cancelScheduledValues(audio.ctx.currentTime);
        audio.gain.gain.setValueAtTime(audio.on ? 0.035 : 0, audio.ctx.currentTime);
      } catch (err) {}
    }
  }


  // =====================================================================
  // COMMAND-CENTER DASHBOARD — presentation and demo utilities
  // =====================================================================
  const trendSamples = [];
  const trendCanvas = $("trendChart");
  const trendCtx = trendCanvas ? trendCanvas.getContext("2d") : null;

  function drawTrendChart() {
    if (!trendCtx || !trendCanvas) return;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = Math.max(220, trendCanvas.clientWidth || 300), h = 100;
    trendCanvas.width = Math.round(w * dpr);
    trendCanvas.height = Math.round(h * dpr);
    trendCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
    trendCtx.clearRect(0, 0, w, h);
    const styles = getComputedStyle(document.documentElement);
    const grid = styles.getPropertyValue("--border").trim() || "#dce6e8";
    const mutedText = styles.getPropertyValue("--text-muted").trim() || "#5b7278";
    const drawLine = (key, color, min, max) => {
      if (trendSamples.length < 2) return;
      trendCtx.beginPath();
      trendSamples.forEach((sample, i) => {
        const x = 5 + i / (Math.max(1, trendSamples.length - 1)) * (w - 10);
        const y = h - 8 - clamp((sample[key] - min) / (max - min), 0, 1) * (h - 20);
        if (i === 0) trendCtx.moveTo(x, y); else trendCtx.lineTo(x, y);
      });
      trendCtx.strokeStyle = color;
      trendCtx.lineWidth = 2;
      trendCtx.lineJoin = "round";
      trendCtx.lineCap = "round";
      trendCtx.stroke();
    };
    trendCtx.strokeStyle = grid;
    trendCtx.lineWidth = 1;
    for (let i = 0; i < 3; i++) {
      const y = 8 + i * 39;
      trendCtx.beginPath(); trendCtx.moveTo(0, y); trendCtx.lineTo(w, y); trendCtx.stroke();
    }
    drawLine("pressure", "#0b9c95", 0, 100);
    drawLine("temperature", "#d69a35", 30, 39);
    trendCtx.fillStyle = mutedText;
    trendCtx.font = "9px system-ui";
    trendCtx.fillText("100 mmHg", 5, 9);
    trendCtx.fillText("0", 5, h - 2);
  }

  function updateCommandCenter() {
    const overall = overallStatus();
    const alerts = PARAMS.filter(p => state.status[p.id] !== "safe").length;
    const unsafe = PARAMS.some(p => state.status[p.id] === "unsafe");
    const caution = PARAMS.some(p => state.status[p.id] === "caution");
    const overallEl = $("ccOverall");
    if (overallEl) {
      overallEl.textContent = overall.toUpperCase();
      $("ccOverallSub").textContent = unsafe ? "Immediate review suggested" : caution ? "Monitor readings closely" : "No active warnings";
      $("ccOverall").parentElement.className = "cc-kpi " + (unsafe ? "alert" : caution ? "caution" : "");
    }
    if ($("ccAlerts")) $("ccAlerts").textContent = String(alerts);
    if ($("ccTime")) $("ccTime").textContent = Math.floor(state.tpos) + "m";
    if ($("sensorStrip")) {
      const live = state.mode === "live";
      const pill = document.querySelector(".live-pill");
      if (pill) pill.innerHTML = "<i></i> " + (live ? "LIVE ARDUINO" : "LIVE SIMULATION");
      $("sensorStrip").querySelectorAll("span").forEach((el, i) => {
        const id = ["pressure", "temperature", "humidity", "friction"][i];
        el.classList.toggle("degraded", state.status[id] !== "safe");
      });
    }
  }

  function addTrendSample() {
    trendSamples.push({ pressure: state.values.pressure, temperature: state.values.temperature });
    if (trendSamples.length > 48) trendSamples.shift();
    drawTrendChart();
  }

  $("exportBtn")?.addEventListener("click", () => {
    const rows = [
      ["Metric", "Reading", "Unit", "Status", "Model threshold (caution / unsafe)"],
      ...PARAMS.map(p => [
        p.label, p.id === "time" ? Math.round(state.tpos) : state.values[p.id],
        p.unit, state.status[p.id], getThreshold(p.id).caution + " / " + getThreshold(p.id).unsafe
      ]),
      [],
      ["Data source", state.mode === "live" ? "Live Arduino serial" : state.mode === "manual" ? "Manual demo" : "Auto simulation"],
      ["Simulation season", SEASONS[state.season].label],
      ["Simulation clock", fmtClock(state.clockMin)],
      ["Current position", POSITIONS[state.posIndex].name],
      ["Report note", "Demonstration simulation only — not a clinical record."]
    ];
    const csv = rows.map(row => row.map(value => '"' + String(value ?? "").replace(/"/g, '""') + '"').join(",")).join("\r\n");
    const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url; a.download = "smart-care-demo-report.csv";
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1000);
    showToast("Demo report exported as CSV");
  });

  $("fullscreenBtn")?.addEventListener("click", async () => {
    const target = $("sceneWrap");
    try {
      if (!document.fullscreenElement) await target.requestFullscreen();
      else await document.exitFullscreen();
    } catch (err) { showToast("Full-screen is not available in this browser"); }
  });

  $("themeBtn")?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next;
    if (typeof applySceneTheme === "function") applySceneTheme();
  });

  document.addEventListener("visibilitychange", () => {
    if (document.hidden) return;
    drawTrendChart();
  });
  window.addEventListener("resize", drawTrendChart);

  // =====================================================================
  // MAIN LOOP
  // =====================================================================
  buildTable();
  setValuesToModel();
  PARAMS.forEach(paintTrack);
  markTable();
  renderLog();
  setMode("auto");
  updateStatuses();
  updateRepos();
  updateCommandCenter();
  addTrendSample();

  if (typeof THREE !== "undefined") {
    try { init3D(); } catch (err) {
      const f = document.createElement("div"); f.className = "fallback";
      f.innerHTML = '<div class="fallback-card"><div class="fallback-bed">🛏️</div><strong>3D visualization unavailable</strong><span>This browser or device could not start WebGL. The sensor simulation, dashboard controls, and Gemini AI feature can still work.</span></div>';
      $("sceneWrap").appendChild(f);
    }
  } else {
    const f = document.createElement("div"); f.className = "fallback";
    f.innerHTML = '<div class="fallback-card"><div class="fallback-bed">🛏️</div><strong>3D visualization could not load</strong><span>The 3D library did not load. The sensor simulation, dashboard controls, and Gemini AI feature can still work.</span></div>';
    $("sceneWrap").appendChild(f);
  }

  let last = performance.now(), uiAcc = 0, histAcc = 0, noiseAcc = 0;
  function frame(nowMs) {
    requestAnimationFrame(frame);
    const dt = Math.min(0.1, (nowMs - last) / 1000); last = nowMs;
    noiseAcc += dt;
    if (noiseAcc > 0.4) {
      noiseAcc = 0;
      PARAMS.filter((p) => p.model).forEach((p) => { noiseVal[p.id] += ((Math.random() * 2 - 1) * p.noise - noiseVal[p.id]) * 0.5; });
    }
    tickSim(dt);
    uiAcc += dt;
    if (uiAcc > 0.1) { uiAcc = 0; updateStatuses(); updateRepos(); updateCommandCenter(); }
    histAcc += dt;
    if (histAcc > 0.5) { histAcc = 0; pushHistory(); addTrendSample(); }
    updateBuzzer(nowMs);
    if (render3D) render3D(dt, nowMs);
  }
  requestAnimationFrame(frame);

  // Read-only snapshot used by the Firebase demo save button below.
  window.getBedsoreDemoSnapshot = function () {
    return {
      values: { ...state.values },
      status: { ...state.status }
    };
  };
})();
</script>


